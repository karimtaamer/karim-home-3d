{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/renders/:path*", "destination": "https://ezauif7vtmi92gwt.public.blob.vercel-storage.com/renders/:path*" },
    { "source": "/api/photospot/:action", "destination": "/api/photospot?action=:action" }
